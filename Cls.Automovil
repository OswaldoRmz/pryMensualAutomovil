using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace pryMensualAutomovil
{
    public abstract class Automovil:clsTarifa
    {
    public double Horas { get; set; }

    public override double CalcularTarifa()
    {
     return Horas * 30;
    }
        
    }
